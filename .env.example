APP_ENV=development
DATABASE_URL=sqlite:///./favorit.db
JWT_SECRET=replace-with-a-long-random-secret
TOKEN_DAYS=30
SEED_DEMO_DATA=true
ENABLE_DEMO=true
ENABLE_REMINDER_WORKER=true
ALLOWED_ORIGINS=http://localhost:8000

# TurboSMS login codes. Keep the API token secret.
TURBOSMS_TOKEN=
TURBOSMS_SENDER=TurboSMS

# Web Push / VAPID.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
